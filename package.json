{
  "name": "chatgpt-memory-insights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp",
      "workerd"
    ]
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "lint": "ultracite check .",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "deploy": "node scripts/require-clean-main.mjs && pnpm run check && wrangler pages deploy dist --project-name=chatgpt-memory-insights --branch=main"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@observablehq/plot": "0.6.17",
    "@zip.js/zip.js": "2.8.34",
    "astro": "7.1.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@biomejs/biome": "2.5.5",
    "@tailwindcss/vite": "4.3.3",
    "lightningcss": "1.30.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "ultracite": "7.10.2",
    "vitest": "4.1.0",
    "wrangler": "4.114.0"
  }
}
