---
import "../styles/global.css";
import "../styles/about.css";

const title = "What Memory Map finds in your ChatGPT history";
const description =
  "See every insight Memory Map can find in a ChatGPT export: recurring questions, topic connections, memory changes, query patterns, conversation strands, and private semantic search.";

const capabilityRoutes = [
  {
    code: "A",
    className: "route-cobalt",
    title: "Your questions, counted honestly",
    summary:
      "Fast local rules read the full parsed export first, so useful totals arrive even if the embedding model cannot load.",
    stops: [
      {
        title: "History overview",
        detail:
          "Conversations, messages, your prompts, approximate words, active days, date range, and longest activity streak.",
      },
      {
        title: "Conversation depth",
        detail:
          "Median message depth plus short, medium, and deep conversation groups.",
      },
      {
        title: "Activity rhythms",
        detail:
          "Conversation volume by month, with source date range and peak-period evidence.",
      },
      {
        title: "Recurring terms",
        detail:
          "Frequently used meaningful terms that can surface themes worth revisiting.",
      },
      {
        title: "Exact repeated questions",
        detail:
          "Near-identical wording grouped with count, first ask, last ask, and source conversations.",
      },
      {
        title: "10 overlapping question domains",
        detail:
          "Math, health, software, money, career, learning, creative work, relationships, travel, and planning—each with query count, conversation count, monthly history, and evidence.",
      },
      {
        title: "Likely typo signals",
        detail:
          "A deliberately small disclosed misspelling list plus repeated-word checks—not a grammar or writing-quality score.",
      },
      {
        title: "Possible thread changes",
        detail:
          "Low-overlap adjacent prompts flag conversations that may contain several tracks before deeper semantic segmentation runs.",
      },
    ],
  },
  {
    code: "B",
    className: "route-signal",
    title: "Meaning, not just matching words",
    summary:
      "A pinned embedding model runs inside the browser to connect differently worded questions, conversations, facts, and strands.",
    stops: [
      {
        title: "Automatic model selection",
        detail:
          "Chooses a compact English profile or multilingual profile from the writing systems in your prompts; manual selection remains available.",
      },
      {
        title: "Visible model cost",
        detail:
          "Shows the pinned model, revision, selection reason, and approximate first-download size: about 24 MB compact or 135 MB multilingual.",
      },
      {
        title: "Semantic topic clusters",
        detail:
          "Groups sampled conversations by meaning and names them against 20 broad topic anchors plus distinctive terms from your history.",
      },
      {
        title: "Interactive topic graph",
        detail:
          "Node size represents conversation count; edges represent semantic proximity; selecting a node opens its evidence.",
      },
      {
        title: "Semantic repeated questions",
        detail:
          "Finds similar intent even when the wording changed, while keeping these groups distinct from exact repeats.",
      },
      {
        title: "Four memory states",
        detail:
          "Current, updated, explicitly refuted, and possible contradiction—detected only from first-person statements, never assistant assertions.",
      },
      {
        title: "Memory change history",
        detail:
          "Keeps earlier and later wording, dates, update or refutation cues, semantic similarity, lexical overlap, confidence, and source conversations.",
      },
      {
        title: "Semantic conversation strands",
        detail:
          "Splits substantial multi-prompt conversations into ordered strands with visible boundaries, snippets, continuity, and confidence.",
      },
    ],
  },
  {
    code: "C",
    className: "route-violet",
    title: "How your map changes over time",
    summary:
      "Monthly evidence distinguishes a momentary spike from a theme that is growing, fading, returning, or holding steady.",
    stops: [
      {
        title: "Topic evolution",
        detail:
          "Monthly histories and local trend labels for semantic topic clusters.",
      },
      {
        title: "Question-domain evolution",
        detail:
          "See whether health, software, planning, learning, and the other lenses become more or less prominent.",
      },
      {
        title: "Language-signal evolution",
        detail:
          "Tracks curiosity, frustration, urgency, uncertainty, excitement, appreciation, and neutral/direct wording by month.",
      },
      {
        title: "Five explicit trend states",
        detail:
          "Emerging, fading, resurfacing, steady, or not enough history—descriptions of the series, never explanations of why you changed.",
      },
      {
        title: "Positive, neutral, and negative wording",
        detail:
          "A compact lexical tone distribution and negative-wording rate, explicitly separated from personality or mental-health claims.",
      },
      {
        title: "Evidence-backed reflection questions",
        detail:
          "Open questions triggered by repeats, changed or refuted memories, possible contradictions, frustration-wording spikes, stale memories, dormant themes, recurring terms, and activity peaks.",
      },
    ],
  },
  {
    code: "D",
    className: "route-teal",
    title: "Search that explains itself",
    summary:
      "The derived index is useful as memory because search results and every inferred insight retain a route back to the conversation evidence.",
    stops: [
      {
        title: "Natural-language memory search",
        detail:
          "Search conversations, individual questions, fact candidates, topics, and semantic strands with a hybrid semantic and lexical index.",
      },
      {
        title: "Typed, scored results",
        detail:
          "Each result identifies what it is, shows why it matched, includes a similarity score, and opens its topic or source.",
      },
      {
        title: "Evidence drawer",
        detail:
          "Topics, repeats, facts, domains, typo signals, strands, trends, language signals, and reflections all open supporting conversations.",
      },
      {
        title: "Adjustable evidence confidence",
        detail:
          "Exploratory, balanced, conservative, and custom thresholds refilter inferred repeats, memory changes, strand boundaries, and reflections without rereading the ZIP.",
      },
      {
        title: "Transparent sampling",
        detail:
          "The report states how many conversations, prompts, facts, and thread prompts were embedded versus the full parsed totals.",
      },
      {
        title: "Keyboard and non-graph access",
        detail:
          "A complete topic list mirrors the SVG graph; graph nodes, tabs, dialogs, search, and import controls support keyboard use and visible focus.",
      },
    ],
  },
  {
    code: "E",
    className: "route-amber",
    title: "Private and recoverable by construction",
    summary:
      "There is no application server waiting for the archive. Parsing, analysis, search, and optional persistence happen on the device.",
    stops: [
      {
        title: "Original ZIP import",
        detail:
          "Accepts current ChatGPT exports containing one or more conversations*.json files; no manual unzipping required.",
      },
      {
        title: "Incremental split-file parsing",
        detail:
          "Reads large conversation chunks sequentially in a Web Worker instead of loading the whole archive into the page at once.",
      },
      {
        title: "Attachments stay unread",
        detail:
          "Binary attachments, chat.html, and unrelated export files are ignored.",
      },
      {
        title: "No archive upload",
        detail:
          "Conversation text is not sent to an application API, account system, analytics payload, or model endpoint.",
      },
      {
        title: "Deterministic fallback",
        detail:
          "Totals, activity, domains, exact repeats, wording signals, typo candidates, and initial thread candidates remain useful if embeddings fail.",
      },
      {
        title: "Nothing saved by default",
        detail:
          "The page does not persist the archive or derived index unless you explicitly choose “Keep on this device.”",
      },
      {
        title: "Device-local save, restore, and forget",
        detail:
          "An opt-in IndexedDB snapshot restores the derived report and search index; incompatible old snapshots are rejected and removed; Forget deletes the saved copy.",
      },
      {
        title: "Visible progress and recovery",
        detail:
          "Parse, statistics, model, embedding, and clustering stages report progress; analysis can be cancelled, errors explain recovery, and a new archive resets the report.",
      },
    ],
  },
] as const;

const totalCapabilities = capabilityRoutes.reduce((sum, route) => sum + route.stops.length, 0);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f5f2" />
    <title>{title}</title>
  </head>
  <body class="about-page">
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="about-nav">
      <a class="brand" href="/" aria-label="Memory Map analysis app">
        <svg viewBox="0 0 36 36" aria-hidden="true">
          <path d="M7 8 17 15 29 7M17 15l1 14M7 27l11 2 11-9" />
          <circle cx="7" cy="8" r="3" />
          <circle cx="29" cy="7" r="3" />
          <circle cx="17" cy="15" r="3" />
          <circle cx="7" cy="27" r="3" />
          <circle cx="18" cy="29" r="3" />
          <circle cx="29" cy="20" r="3" />
        </svg>
        <span>Memory Map</span>
      </a>
      <nav aria-label="About Memory Map">
        <a href="#capabilities">What it finds</a>
        <a href="#privacy">Privacy</a>
        <a href="#export">Get the ZIP</a>
      </nav>
      <a class="about-nav-action" href="/">Analyze my ZIP</a>
    </header>
    <nav class="about-section-nav" aria-label="Page sections">
      <a href="#capabilities"><i class="route-dot route-blue"></i>What it finds</a>
      <a href="#privacy"><i class="route-dot route-teal"></i>Privacy</a>
      <a href="#export"><i class="route-dot route-amber"></i>Get the ZIP</a>
    </nav>

    <main id="main">
      <!--
      THESIS: A ChatGPT archive becomes usable memory, not a nostalgic statistics recap.
      OWN-WORLD: Cool map paper, transit rules, labelled interchanges, flat platform boards, and evidence annotations.
      STORY: Recognize the problem, see the memory mechanism, inspect every route, trust the privacy boundary, then analyze a ZIP.
      FIRST VIEWPORT: Outcome and one primary action at left; a large illustrative topic-memory interchange at right; verified counts form the platform edge.
      FORM: Capability atlas, grounded structure six, transit-stack staging, preserve lane, concept seed 2f09553c.
      -->
      <section class="about-hero" aria-labelledby="about-heading">
        <div class="about-hero-copy">
          <p class="map-key">A private atlas of your ChatGPT history</p>
          <h1 id="about-heading">Turn your ChatGPT history into usable memory.</h1>
          <p class="about-lede">
            Find the questions you repeat, facts you changed, themes you left behind, and ideas
            that connect across years of conversations. Your export is analyzed in this browser,
            then becomes a searchable map with evidence behind every suggestion.
          </p>
          <a class="about-primary-action" href="/">Analyze my ChatGPT ZIP</a>
          <p class="about-hero-proof">
            <strong>10</strong> question domains <span aria-hidden="true">·</span>
            <strong>4</strong> memory states <span aria-hidden="true">·</span>
            <strong>2</strong> model profiles <span aria-hidden="true">·</span>
            <strong>0</strong> archive uploads
          </p>
        </div>

        <figure class="about-map-preview">
          <figcaption>
            <span>Illustrative preview</span>
            <strong>One history. Several connected routes.</strong>
          </figcaption>
          <svg viewBox="0 0 760 570" aria-hidden="true">
            <g class="preview-grid">
              <path d="M44 95H716M44 190H716M44 285H716M44 380H716M44 475H716" />
              <path d="M140 48V522M260 48V522M380 48V522M500 48V522M620 48V522" />
            </g>
            <g class="preview-lines">
              <path class="preview-blue" d="M75 430 220 330 390 330 555 205 690 205" />
              <path class="preview-red" d="M105 145 220 235 390 330 540 430 675 430" />
              <path class="preview-teal" d="M220 75V235L390 330 555 330" />
              <path class="preview-violet" d="M390 95V330L555 485" />
            </g>
            <g class="preview-stops">
              <circle class="stop-blue" cx="75" cy="430" r="9" />
              <circle class="stop-red" cx="105" cy="145" r="9" />
              <circle class="stop-teal" cx="220" cy="75" r="9" />
              <circle class="stop-red" cx="220" cy="235" r="9" />
              <circle class="stop-blue" cx="220" cy="330" r="9" />
              <circle class="stop-violet" cx="390" cy="95" r="9" />
              <circle class="stop-interchange" cx="390" cy="330" r="18" />
              <circle class="stop-teal" cx="555" cy="330" r="9" />
              <circle class="stop-blue" cx="555" cy="205" r="9" />
              <circle class="stop-violet" cx="555" cy="485" r="9" />
              <circle class="stop-red" cx="675" cy="430" r="9" />
              <circle class="stop-blue" cx="690" cy="205" r="9" />
            </g>
          </svg>
          <div class="preview-label label-question">
            <span>Repeated question</span><strong>“How should I prioritize this?” × 7</strong>
          </div>
          <div class="preview-label label-topic">
            <span>Connected topic</span><strong>Product · planning</strong>
          </div>
          <div class="preview-label label-memory">
            <span>Memory updated</span><strong>“I now prefer…”</strong>
          </div>
          <div class="preview-label label-search">
            <span>Search destination</span><strong>Decisions I postponed</strong>
          </div>
          <div class="preview-interchange-label">
            <span>Evidence interchange</span>
            <strong>12 source conversations</strong>
          </div>
        </figure>

        <div class="about-platform-board" aria-label="What the product connects">
          <span>Questions</span>
          <i aria-hidden="true"></i>
          <span>Topics</span>
          <i aria-hidden="true"></i>
          <span>Facts</span>
          <i aria-hidden="true"></i>
          <span>Time</span>
          <i aria-hidden="true"></i>
          <span>Sources</span>
        </div>
      </section>

      <section class="about-problem" aria-labelledby="problem-heading">
        <p class="map-key">Why this exists</p>
        <div>
          <h2 id="problem-heading">Your archive remembers more than any single chat can.</h2>
          <div class="about-problem-copy">
            <p>
              A long ChatGPT history contains decisions revisited under different wording,
              personal facts that later stopped being true, projects scattered across unrelated
              chats, and patterns that are almost impossible to see one conversation at a time.
            </p>
            <p>
              Memory Map treats those conversations as evidence. It counts what can be counted
              exactly, uses local embeddings where meaning matters, and always keeps a route back
              to the sources.
            </p>
          </div>
        </div>
      </section>

      <section id="capabilities" class="capability-atlas" aria-labelledby="capability-heading">
        <header class="about-section-heading">
          <div>
            <p class="map-key">Complete capability atlas</p>
            <h2 id="capability-heading">Everything the map can show you.</h2>
          </div>
          <p>
            {totalCapabilities} shipped capabilities across five routes. These are current product
            behaviors, not a roadmap.
          </p>
        </header>

        <div class="capability-routes">
          {
            capabilityRoutes.map((route) => (
              <details class:list={["capability-route", route.className]} open={route.code === "A"}>
                <summary>
                  <span class="route-code" aria-hidden="true">{route.code}</span>
                  <div>
                    <h3>{route.title}</h3>
                    <p>{route.summary}</p>
                  </div>
                  <span class="route-count">{route.stops.length} stops</span>
                </summary>
                <ol>
                  {route.stops.map((stop) => (
                    <li>
                      <span class="capability-stop" aria-hidden="true" />
                      <div>
                        <strong>{stop.title}</strong>
                        <p>{stop.detail}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </details>
            ))
          }
        </div>
      </section>

      <section id="privacy" class="privacy-architecture" aria-labelledby="privacy-heading">
        <header class="about-section-heading">
          <div>
            <p class="map-key">The privacy architecture</p>
            <h2 id="privacy-heading">Your conversations never need an application server.</h2>
          </div>
          <p>
            The website is static. The analysis pipeline lives in your tab and its Web Worker.
          </p>
        </header>

        <ol class="privacy-route">
          <li>
            <span>1</span>
            <strong>Your original ZIP</strong>
            <p>You choose it from your device. It is not submitted through a web form.</p>
          </li>
          <li>
            <span>2</span>
            <strong>Incremental browser parsing</strong>
            <p>Conversation JSON chunks are read one at a time; attachments remain ignored.</p>
          </li>
          <li>
            <span>3</span>
            <strong>Local rules + embeddings</strong>
            <p>
              Statistics run first. A pinned Hugging Face model file downloads separately, then
              embeds bounded text on your device.
            </p>
          </li>
          <li>
            <span>4</span>
            <strong>Your report and search index</strong>
            <p>
              Nothing persists unless you explicitly save the derived memory to this browser.
            </p>
          </li>
        </ol>

        <div class="privacy-boundaries">
          <div>
            <span class="boundary-yes">Stays here</span>
            <p>Archive text, parsed prompts, fact candidates, embeddings, report, and search index.</p>
          </div>
          <div>
            <span class="boundary-out">Comes in</span>
            <p>Pinned embedding-model files from Hugging Face. Your prompt text is not part of that request.</p>
          </div>
          <div>
            <span class="boundary-no">Does not exist</span>
            <p>Archive upload endpoint, Memory Map account, cross-device sync, or server-side analysis.</p>
          </div>
        </div>
      </section>

      <section class="fit-board" aria-labelledby="fit-heading">
        <header>
          <p class="map-key">Know before you import</p>
          <h2 id="fit-heading">Built for reflection. Not diagnosis.</h2>
        </header>
        <div class="fit-columns">
          <div>
            <h3>Memory Map is a good fit if you want to…</h3>
            <ul>
              <li>Find recurring questions and decisions across many chats.</li>
              <li>Build a searchable index of your own prompts, topics, facts, and strands.</li>
              <li>Review what you explicitly updated, rejected, or may have contradicted.</li>
              <li>See how interests and wording signals changed over time.</li>
              <li>Keep the archive on your device and inspect the evidence behind suggestions.</li>
            </ul>
          </div>
          <div>
            <h3>It is not currently the right tool if you need…</h3>
            <ul>
              <li>Attachment, image, audio, or exported-memory-file analysis.</li>
              <li>A generative biography, automatic life summary, or personality profile.</li>
              <li>Medical, mental-health, or emotional diagnosis.</li>
              <li>Verified truth—the fact ledger contains candidates from your wording.</li>
              <li>Accounts, team collaboration, cross-device sync, or server backups.</li>
            </ul>
          </div>
        </div>
      </section>

      <section id="export" class="about-export" aria-labelledby="export-heading">
        <div class="about-export-intro">
          <p class="map-key">Your ticket in</p>
          <h2 id="export-heading">Download the ZIP directly from ChatGPT.</h2>
          <p>
            Keep it zipped. Memory Map knows how to find split conversation files and ignores the
            binary attachments.
          </p>
        </div>
        <ol>
          <li>
            <span>1</span>
            <p>
              Sign in to ChatGPT, open your profile menu, and choose{" "}
              <strong>Settings → Data controls</strong>.
            </p>
          </li>
          <li>
            <span>2</span>
            <p>
              Under <strong>Export data</strong>, choose <strong>Export</strong>, then{" "}
              <strong>Confirm export</strong>.
            </p>
          </li>
          <li>
            <span>3</span>
            <p>
              Open the email or SMS from OpenAI, download the ZIP, and return here without
              unzipping it.
            </p>
          </li>
        </ol>
        <aside>
          <p>
            OpenAI says an export can take up to 7 days, and the download link expires 24 hours
            after it arrives. Settings export requires an eligible signed-in account and is not
            available for Business or Enterprise workspaces.
          </p>
          <nav aria-label="ChatGPT export resources">
            <a
              href="https://help.openai.com/en/articles/7260999-how-do-i-export-my-chatgpt-history-and-data"
              target="_blank"
              rel="noreferrer">Official instructions ↗</a
            >
            <a href="https://privacy.openai.com/" target="_blank" rel="noreferrer"
              >Privacy Portal ↗</a
            >
          </nav>
        </aside>
      </section>

      <section class="about-final" aria-labelledby="final-heading">
        <div>
          <p class="map-key">Next stop</p>
          <h2 id="final-heading">Your history is already there. Make it navigable.</h2>
        </div>
        <a class="about-primary-action" href="/">Analyze my ChatGPT ZIP</a>
        <p>
          No account. No archive upload. Nothing saved unless you ask.
        </p>
      </section>
    </main>

    <footer class="about-footer">
      <a class="brand" href="/">
        <svg viewBox="0 0 36 36" aria-hidden="true">
          <path d="M7 8 17 15 29 7M17 15l1 14M7 27l11 2 11-9" />
          <circle cx="7" cy="8" r="3" />
          <circle cx="29" cy="7" r="3" />
          <circle cx="17" cy="15" r="3" />
          <circle cx="7" cy="27" r="3" />
          <circle cx="18" cy="29" r="3" />
          <circle cx="29" cy="20" r="3" />
        </svg>
        <span>Memory Map</span>
      </a>
      <p>Not a wrapped. Not a diagnosis. A map back to your own evidence.</p>
      <a href="/">Analyze my ChatGPT ZIP →</a>
    </footer>
  </body>
</html>
