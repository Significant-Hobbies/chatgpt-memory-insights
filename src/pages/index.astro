---
import "../styles/global.css";

const title = "Memory Map — Explore your ChatGPT history";
const description =
  "Turn a ChatGPT export ZIP into a private topic graph, searchable memory, repeated-question report, and fact history in your browser.";
---

<!--
THESIS: Conversation history becomes a navigable memory network, not a dashboard of vanity totals.
OWN-WORLD: Cool paper, ink rules, colored transit routes, labelled interchanges, and evidence-ledger rows.
STORY: Import privately, see the map form, search it, then inspect the sources behind every suggestion.
FIRST VIEWPORT: Before import, one route gate. After import, search and the semantic graph dominate with a fact ledger at right.
FORM: Graph-first memory workbench; selected delegated probe; direction seed 100c1b70, grounded candidate five with transit-stack staging.
-->

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f5f2" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <div class="app-shell">
      <aside class="route-rail" aria-label="Report sections">
        <a class="brand" href="#main" aria-label="Memory Map home">
          <svg viewBox="0 0 36 36" aria-hidden="true">
            <path d="M7 8 17 15 29 7M17 15l1 14M7 27l11 2 11-9" />
            <circle cx="7" cy="8" r="3" />
            <circle cx="29" cy="7" r="3" />
            <circle cx="17" cy="15" r="3" />
            <circle cx="7" cy="27" r="3" />
            <circle cx="18" cy="29" r="3" />
            <circle cx="29" cy="20" r="3" />
          </svg>
          <span>Memory Map</span>
        </a>
        <p class="brand-note">Detected from your own statements.</p>

        <nav id="report-nav" hidden>
          <p class="map-key">Routes</p>
          <a href="#visual-atlas"><i class="route-dot route-red"></i>Visual atlas</a>
          <a href="#topic-map"><i class="route-dot route-blue"></i>Topic map</a>
          <a href="#memory-ledger"><i class="route-dot route-teal"></i>Memory ledger</a>
          <a href="#evolution"><i class="route-dot route-violet"></i>How it changed</a>
          <a href="#question-lenses"><i class="route-dot route-amber"></i>Question lenses</a>
          <a href="#repeated-questions"><i class="route-dot route-red"></i>Repeated questions</a>
          <a href="#reflection-questions"><i class="route-dot route-violet"></i>Questions for you</a>
          <a href="#query-tone"><i class="route-dot route-amber"></i>Query tone</a>
          <a href="#rhythms"><i class="route-dot route-violet"></i>Rhythms</a>
        </nav>

        <div class="rail-footer">
          <a href="/about">What Memory Map does</a>
          <span class="rail-privacy">
            <span class="privacy-mark" aria-hidden="true">◇</span>
            <span>Archive contents stay on this device</span>
          </span>
        </div>
      </aside>

      <main id="main">
        <section id="import-view" class="import-view" aria-labelledby="import-heading">
          <div class="import-copy">
            <p class="map-key">Your history, made navigable</p>
            <h1 id="import-heading">Find the questions, facts, and ideas you keep returning to.</h1>
            <p class="lede">
              Choose your ChatGPT export. Memory Map reads its conversation files in this tab,
              then builds a searchable semantic graph with a browser-loaded embedding model.
            </p>
            <a class="product-tour-link" href="/about"
              >See all 36 things Memory Map can find →</a
            >
          </div>

          <details class="export-guide">
            <summary>
              <span>Need the ZIP?</span>
              <strong>How to export your ChatGPT data</strong>
            </summary>
            <div class="export-guide-body">
              <ol>
                <li>
                  Sign in to ChatGPT, open your profile menu, then choose{" "}
                  <strong>Settings → Data controls</strong>.
                </li>
                <li>
                  Under <strong>Export data</strong>, choose <strong>Export</strong>, then{" "}
                  <strong>Confirm export</strong>.
                </li>
                <li>
                  Open the email or SMS from OpenAI, download the ZIP, and bring it here without
                  unzipping it.
                </li>
              </ol>
              <div class="export-guide-notes">
                <p>
                  Exports can take up to 7 days. The download link expires 24 hours after it
                  arrives.
                </p>
                <p>
                  Settings exports require a signed-in eligible account and are not available for
                  ChatGPT Business or Enterprise workspaces.
                </p>
              </div>
              <nav class="export-guide-links" aria-label="ChatGPT export resources">
                <a href="https://chatgpt.com/" target="_blank" rel="noreferrer">Open ChatGPT ↗</a>
                <a
                  href="https://help.openai.com/en/articles/7260999-how-do-i-export-my-chatgpt-history-and-data"
                  target="_blank"
                  rel="noreferrer">Official instructions ↗</a
                >
                <a href="https://privacy.openai.com/" target="_blank" rel="noreferrer"
                  >Privacy Portal ↗</a
                >
              </nav>
            </div>
          </details>

          <fieldset class="analysis-setup">
            <legend>Choose the analysis lens</legend>
            <div class="model-profile-options">
              <label>
                <input type="radio" name="model-profile" value="auto" checked />
                <span><strong>Automatic</strong><small>Selects from the writing systems used in your prompts.</small></span>
              </label>
              <label>
                <input type="radio" name="model-profile" value="compact" />
                <span><strong>Compact English</strong><small>Smaller download for English-first histories.</small></span>
              </label>
              <label>
                <input type="radio" name="model-profile" value="multilingual" />
                <span><strong>Multilingual</strong><small>≈135 MB · meaning across many languages.</small></span>
              </label>
            </div>
            <div class="confidence-control">
              <div>
                <strong>Evidence confidence</strong>
                <small>Higher confidence shows fewer, stronger inferred connections.</small>
              </div>
              <div class="confidence-presets" aria-label="Evidence confidence presets">
                <button type="button" data-confidence="45">Exploratory</button>
                <button type="button" data-confidence="65" aria-pressed="true">Balanced</button>
                <button type="button" data-confidence="82">Conservative</button>
              </div>
              <label for="confidence-input">
                <span>Threshold</span>
                <input id="confidence-input" type="range" min="35" max="90" value="65" />
                <output id="confidence-output" for="confidence-input">65%</output>
              </label>
            </div>
          </fieldset>

          <div class="import-grid">
            <label id="drop-zone" class="drop-zone" for="archive-input">
              <input id="archive-input" type="file" accept=".zip,application/zip" />
              <span class="file-mark" aria-hidden="true">.ZIP</span>
              <strong>Choose your ChatGPT export</strong>
              <span>or drop the original ZIP here</span>
              <small>Conversation JSON is read. Attachments and chat.html are ignored.</small>
            </label>

            <ol class="route-explainer" aria-label="Analysis stages">
              <li>
                <span>1</span>
                <div><strong>Parse</strong><small>Read split conversation files one at a time.</small></div>
              </li>
              <li>
                <span>2</span>
                <div><strong>Map</strong><small>Embed bounded prompts and fact candidates.</small></div>
              </li>
              <li>
                <span>3</span>
                <div><strong>Explore</strong><small>Search, inspect repeats, and trace every result.</small></div>
              </li>
            </ol>
          </div>

          <div class="privacy-contract">
            <strong>Private by construction.</strong>
            <span>
              No upload endpoint, account, analytics payload, or archive persistence. Model files
              download from Hugging Face; your conversation text is not sent with that request.
            </span>
          </div>
        </section>

        <section id="progress-view" class="progress-view" hidden aria-labelledby="progress-heading">
          <div class="progress-heading-row">
            <div>
              <p id="progress-phase" class="map-key">Reading archive</p>
              <h1 id="progress-heading">Building your memory map</h1>
            </div>
            <button id="cancel-analysis" class="button-secondary" type="button">Cancel</button>
          </div>
          <div class="progress-route" aria-hidden="true">
            <span class="progress-stop is-active"></span>
            <span class="progress-line"><i id="progress-line-fill"></i></span>
            <span class="progress-stop"></span>
          </div>
          <div
            id="progress-status"
            class="progress-status"
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
            Inspecting ZIP entries…
          </div>
          <p class="progress-note">
            Statistics appear before embeddings finish. The first semantic run downloads and
            caches the selected model in your browser.
          </p>
        </section>

        <section id="error-view" class="error-view" hidden aria-labelledby="error-heading">
          <p class="map-key">Route interrupted</p>
          <h1 id="error-heading">This archive could not be mapped.</h1>
          <p id="error-message"></p>
          <button id="error-reset" class="button-primary" type="button">Choose another ZIP</button>
        </section>

        <section id="report-view" class="report-view" hidden>
          <header class="report-header">
            <div>
              <p class="map-key">Mapped memory</p>
              <h1>Your conversation history, connected.</h1>
              <p id="report-meta" class="report-meta"></p>
            </div>
            <div class="report-actions">
              <button id="open-story" class="button-story" type="button">
                Play your story
              </button>
              <button id="save-memory" class="button-secondary" type="button">
                Keep on this device
              </button>
              <button id="forget-memory" class="button-secondary danger" type="button" hidden>
                Forget
              </button>
              <button id="reset-report" class="button-secondary" type="button">New archive</button>
            </div>
          </header>

          <form id="memory-search" class="memory-search" role="search">
            <label for="search-query">Search your mapped memory</label>
            <div class="search-field">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="10.5" cy="10.5" r="6.5"></circle>
                <path d="m15.5 15.5 5 5"></path>
              </svg>
              <input
                id="search-query"
                name="query"
                type="search"
                autocomplete="off"
                placeholder="Search the things you have asked, changed, or returned to"
              />
              <button type="submit">Search</button>
            </div>
            <div id="search-results" class="search-results" hidden></div>
          </form>

          <section class="analysis-lens" aria-labelledby="analysis-lens-heading">
            <div>
              <p class="map-key">Filter inferred evidence</p>
              <h2 id="analysis-lens-heading">Analysis lens</h2>
              <p id="model-profile-note"></p>
            </div>
            <div class="report-confidence">
              <div id="report-confidence-presets" class="confidence-presets" aria-label="Report confidence presets">
                <button type="button" data-confidence="45">Exploratory</button>
                <button type="button" data-confidence="65" aria-pressed="true">Balanced</button>
                <button type="button" data-confidence="82">Conservative</button>
              </div>
              <label for="report-confidence-input">
                <span>Visible evidence threshold</span>
                <input id="report-confidence-input" type="range" min="35" max="90" value="65" />
                <output id="report-confidence-output" for="report-confidence-input">65%</output>
              </label>
              <small id="confidence-impact">Semantic candidates will be filtered without re-reading your ZIP.</small>
            </div>
          </section>

          <section id="overview" class="platform-section overview-section" aria-labelledby="overview-heading">
            <div class="section-heading">
              <div>
                <p class="map-key">Network scale</p>
                <h2 id="overview-heading">Overview</h2>
              </div>
              <p id="sampling-note" class="method-note"></p>
            </div>
            <dl id="overview-stats" class="baseline-stats"></dl>
          </section>

          <section
            id="visual-atlas"
            class="platform-section visual-atlas-section"
            aria-labelledby="visual-atlas-heading"
          >
            <div class="section-heading atlas-heading">
              <div>
                <p class="map-key">Six ways to see the archive</p>
                <h2 id="visual-atlas-heading">Visual atlas</h2>
              </div>
              <div class="atlas-period-control">
                <label for="atlas-period">View period</label>
                <select id="atlas-period">
                  <option value="3">Recent 3 months</option>
                  <option value="6">Recent 6 months</option>
                  <option value="12" selected>Recent 12 months</option>
                  <option value="24">Recent 24 months</option>
                  <option value="all">All history</option>
                </select>
                <small id="atlas-period-note">
                  Applied to chronological charts, query tone, and language signals.
                </small>
              </div>
            </div>

            <div class="atlas-key" aria-label="Visual atlas legend">
              <span><i class="atlas-key-deterministic"></i>Full parsed export</span>
              <span><i class="atlas-key-semantic"></i>Embedding-backed sample</span>
              <span><i class="atlas-key-action"></i>Open a mark to inspect sources</span>
            </div>

            <button id="atlas-highlight" class="atlas-highlight" type="button" hidden>
              <span>Start here · strongest signal in this period</span>
              <strong id="atlas-highlight-title"></strong>
              <small id="atlas-highlight-detail"></small>
              <b>Open source conversations →</b>
            </button>

            <div class="visual-atlas-grid">
              <figure class="atlas-figure activity-calendar-figure">
                <figcaption>
                  <span><b>01</b><strong>Activity calendar</strong></span>
                  <small id="activity-window-label">Conversation starts · selected period</small>
                </figcaption>
                <div
                  id="activity-calendar"
                  class="activity-calendar"
                  aria-label="Recent daily conversation activity"
                ></div>
                <details class="chart-data">
                  <summary>Read activity data</summary>
                  <div id="activity-calendar-data" class="chart-data-list"></div>
                </details>
              </figure>

              <figure class="atlas-figure question-mix-figure">
                <figcaption>
                  <span><b>02</b><strong>Question mix over time</strong></span>
                  <small id="question-window-label">Top five overlapping query routes</small>
                </figcaption>
                <div id="question-mix-legend" class="chart-legend"></div>
                <div
                  id="question-mix-chart"
                  class="atlas-plot question-mix-chart"
                  aria-label="Question lens activity over the recent twelve months"
                ></div>
                <details class="chart-data">
                  <summary>Read question-mix data</summary>
                  <div id="question-mix-data" class="chart-data-list"></div>
                </details>
              </figure>

              <figure class="atlas-figure language-matrix-figure">
                <figcaption>
                  <span><b>03</b><strong>Language signal matrix</strong></span>
                  <small id="language-window-label">Dominant vocabulary cue per query</small>
                </figcaption>
                <div
                  id="language-matrix"
                  class="language-matrix"
                  aria-label="Query wording signals by month"
                ></div>
                <p class="atlas-caveat">
                  Wording signals, not feelings, personality, or diagnosis.
                </p>
                <details class="chart-data">
                  <summary>Read language-signal data</summary>
                  <div id="language-matrix-data" class="chart-data-list"></div>
                </details>
              </figure>

              <figure class="atlas-figure repeat-landscape-figure">
                <figcaption>
                  <span><b>04</b><strong>Repeat landscape</strong></span>
                  <small>Frequency × time span · exact and semantic groups</small>
                </figcaption>
                <div
                  id="repeat-landscape"
                  class="atlas-plot repeat-landscape"
                  aria-label="Repeated question groups by frequency and time span"
                ></div>
                <details class="chart-data">
                  <summary>Read repeat data</summary>
                  <div id="repeat-landscape-data" class="chart-data-list"></div>
                </details>
              </figure>

              <figure class="atlas-figure topic-momentum-figure">
                <figcaption>
                  <span><b>05</b><strong>Topic momentum</strong></span>
                  <small>Fading ← local movement → emerging</small>
                </figcaption>
                <div id="topic-momentum-state" class="atlas-forming">
                  <span></span>
                  <strong>Topic movement is still forming.</strong>
                  <small>The other four deterministic views are already usable.</small>
                </div>
                <div
                  id="topic-momentum"
                  class="atlas-plot topic-momentum is-hidden"
                  aria-label="Semantic topics by momentum and conversation count"
                ></div>
                <details class="chart-data">
                  <summary>Read topic-momentum data</summary>
                  <div id="topic-momentum-data" class="chart-data-list"></div>
                </details>
              </figure>

              <figure class="atlas-figure conversation-shape-figure">
                <figcaption>
                  <span><b>06</b><strong>Conversation shape</strong></span>
                  <small>Depth, weekday rhythm, and model mix · all history</small>
                </figcaption>
                <div
                  id="conversation-shape"
                  class="conversation-shape"
                  aria-label="Conversation depth, weekday rhythm, and model usage"
                ></div>
                <details class="chart-data">
                  <summary>Read conversation-shape data</summary>
                  <div id="conversation-shape-data" class="chart-data-list"></div>
                </details>
              </figure>
            </div>
          </section>

          <div class="workbench">
            <section id="topic-map" class="map-panel" aria-labelledby="topic-heading">
              <div class="section-heading">
                <div>
                  <p class="map-key">Things connected by meaning</p>
                  <h2 id="topic-heading">Topic map</h2>
                </div>
                <p>Node size is conversation count. Lines are semantic proximity.</p>
              </div>
              <div id="graph-loading" class="graph-loading">
                <span></span>
                <strong>Semantic map is still forming.</strong>
                <small>Deterministic insights are ready below.</small>
              </div>
              <svg
                id="topic-graph"
                class="topic-graph is-hidden"
                viewBox="0 0 1000 620"
                role="group"
                aria-label="Interactive semantic topic graph"
              ></svg>
              <p class="mobile-graph-note">Focused neighborhood · the complete topic list follows.</p>
              <div id="topic-list" class="topic-list" aria-label="Accessible topic list"></div>
            </section>

            <aside id="memory-ledger" class="ledger-panel" aria-labelledby="ledger-heading">
              <div class="section-heading compact">
                <div>
                  <p class="map-key">Statement history</p>
                  <h2 id="ledger-heading">Memory ledger</h2>
                </div>
              </div>
              <div id="ledger-tabs" class="ledger-tabs" role="tablist" aria-label="Fact states">
                <button type="button" role="tab" data-status="current" aria-selected="true">
                  Current <span>0</span>
                </button>
                <button type="button" role="tab" data-status="updated" aria-selected="false">
                  Updated <span>0</span>
                </button>
                <button type="button" role="tab" data-status="refuted" aria-selected="false">
                  Refuted <span>0</span>
                </button>
                <button type="button" role="tab" data-status="contradicted" aria-selected="false">
                  Possible contradictions <span>0</span>
                </button>
              </div>
              <div id="ledger-list" class="ledger-list">
                <p class="empty-note">Fact candidates appear after semantic grouping.</p>
              </div>
              <p class="ledger-disclaimer">
                Detected from explicit first-person wording. These are candidates, not verified
                truths.
              </p>
            </aside>
          </div>

          <section id="evolution" class="platform-section evolution-section" aria-labelledby="evolution-heading">
            <div class="section-heading">
              <div>
                <p class="map-key">Routes through time</p>
                <h2 id="evolution-heading">How your map changed</h2>
              </div>
              <p>Emerging, fading, and resurfacing are local trend labels—not explanations for why your interests changed.</p>
            </div>
            <div class="evolution-switcher" role="tablist" aria-label="Evolution evidence">
              <button type="button" role="tab" data-evolution="topics" aria-selected="true">Topics</button>
              <button type="button" role="tab" data-evolution="domains" aria-selected="false">Question domains</button>
              <button type="button" role="tab" data-evolution="language" aria-selected="false">Language signals</button>
            </div>
            <div class="evolution-grid">
              <div>
                <div id="evolution-list" class="evolution-list">
                  <p class="empty-note">Evolution routes appear after analysis.</p>
                </div>
              </div>
              <aside class="memory-change-board" aria-labelledby="memory-change-heading">
                <div class="lens-detail-heading">
                  <div>
                    <p class="map-key">Statements that moved</p>
                    <h3 id="memory-change-heading">Memory changes</h3>
                  </div>
                  <strong id="memory-change-total">0</strong>
                </div>
                <div id="memory-change-list" class="memory-change-list"></div>
              </aside>
            </div>
          </section>

          <section
            id="question-lenses"
            class="platform-section"
            aria-labelledby="lenses-heading"
          >
            <div class="section-heading">
              <div>
                <p class="map-key">Different ways to read the archive</p>
                <h2 id="lenses-heading">Question lenses</h2>
              </div>
              <p>
                Queries may appear in more than one domain. Open any result to inspect its
                supporting conversations.
              </p>
            </div>
            <div id="domain-lenses" class="domain-lenses"></div>
            <div class="lens-detail-grid">
              <article class="lens-detail-panel" aria-labelledby="typo-heading">
                <div class="lens-detail-heading">
                  <div>
                    <p class="map-key">Conservative writing signals</p>
                    <h3 id="typo-heading">Likely typos</h3>
                  </div>
                  <strong id="typo-total">0</strong>
                </div>
                <p id="typo-method"></p>
                <div id="typo-list" class="typo-list"></div>
              </article>
              <article class="lens-detail-panel" aria-labelledby="thread-heading">
                <div class="lens-detail-heading">
                  <div>
                    <p class="map-key">Conversations that changed tracks</p>
                    <h3 id="thread-heading">Conversation strands</h3>
                  </div>
                  <strong id="thread-total">0</strong>
                </div>
                <p id="thread-method"></p>
                <div id="thread-list" class="thread-list"></div>
              </article>
            </div>
          </section>

          <section
            id="repeated-questions"
            class="platform-section"
            aria-labelledby="repeats-heading"
          >
            <div class="section-heading">
              <div>
                <p class="map-key">Interchange patterns</p>
                <h2 id="repeats-heading">Questions you return to</h2>
              </div>
              <p>Exact wording and semantic repeats are kept distinct.</p>
            </div>
            <div id="repeat-summary" class="inline-summary"></div>
            <div id="repeat-list" class="repeat-list"></div>
          </section>

          <section
            id="reflection-questions"
            class="platform-section reflection-section"
            aria-labelledby="reflection-heading"
          >
            <div class="section-heading">
              <div>
                <p class="map-key">Prompts from your own evidence</p>
                <h2 id="reflection-heading">Questions your history asks you</h2>
              </div>
              <p>
                Invitations to review a repeat, correction, old memory, quiet theme, or wording
                spike—not conclusions about you.
              </p>
            </div>
            <div id="reflection-list" class="reflection-list"></div>
          </section>

          <section id="query-tone" class="platform-section" aria-labelledby="tone-heading">
            <div class="section-heading">
              <div>
                <p class="map-key">Wording, not personality</p>
                <h2 id="tone-heading">Query tone</h2>
              </div>
              <p id="tone-method"></p>
            </div>
            <div id="tone-bars" class="tone-bars"></div>
            <div class="emotion-heading">
              <p class="map-key">A more expressive vocabulary</p>
              <h3>Language signals in your queries</h3>
              <p id="emotion-method"></p>
            </div>
            <div id="emotion-bars" class="emotion-bars"></div>
          </section>

          <section id="rhythms" class="platform-section" aria-labelledby="rhythms-heading">
            <div class="section-heading">
              <div>
                <p class="map-key">Cadence over time</p>
                <h2 id="rhythms-heading">Rhythms</h2>
              </div>
              <p id="date-range"></p>
            </div>
            <div id="activity-chart" class="activity-chart" aria-label="Conversation activity by month"></div>
          </section>

          <section class="methodology" aria-labelledby="method-heading">
            <p class="map-key">How the map was made</p>
            <h2 id="method-heading">Transparent by default.</h2>
            <div>
              <p>
                Statistics, question lenses, typo and thread-change candidates, query tone,
                language signals, and reflection prompts use local, inspectable rules. Topic
                relationships, semantic repeats, fact grouping, conversation strands, and search
                use normalized browser-loaded embeddings.
              </p>
              <p>
                Assistant assertions are excluded from the fact ledger. Large histories are
                sampled for semantic work while totals continue to cover the full parsed export.
                Confidence controls refilter stored candidates; they do not make inferred evidence
                certain.
              </p>
            </div>
          </section>
        </section>
      </main>
    </div>

    <dialog id="story-dialog" class="story-dialog" aria-labelledby="story-heading">
      <div class="story-shell">
        <header class="story-header">
          <span class="story-brand">Memory Map</span>
          <p id="story-position" aria-live="polite">Slide 1 of 7</p>
          <button id="close-story" type="button" aria-label="Close story">×</button>
        </header>
        <nav id="story-progress" class="story-progress" aria-label="Story slides"></nav>
        <main id="story-slide" class="story-slide" tabindex="-1">
          <p class="story-eyebrow">Your history, in motion</p>
          <h2 id="story-heading">Your ChatGPT history, mapped.</h2>
        </main>
        <footer class="story-controls">
          <button id="story-previous" type="button">← Previous</button>
          <span>Use arrow keys or swipe</span>
          <button id="story-next" type="button">Next →</button>
        </footer>
      </div>
    </dialog>

    <aside
      id="evidence-panel"
      class="evidence-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="evidence-heading"
      hidden
    >
      <button id="close-evidence" class="evidence-close" type="button" aria-label="Close evidence">
        ×
      </button>
      <p class="map-key">Why this appeared</p>
      <h2 id="evidence-heading">Supporting conversations</h2>
      <div id="evidence-content"></div>
    </aside>

    <div id="app-status" class="visually-hidden" role="status" aria-live="polite"></div>
    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
